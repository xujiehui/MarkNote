{
  "name": "marknote",
  "version": "0.1.1",
  "description": "A cross-platform desktop note app for rich text, images, code blocks, and local-first storage.",
  "author": "MarkNote",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build && node scripts/generate-pwa-precache.mjs && node scripts/check-distribution-config.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run build:electron && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "desktop:build": "npm run build && npm run build:electron",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "package:mac": "electron-builder --mac --publish never",
    "package:mac:x64": "electron-builder --mac dmg zip --x64 --publish never",
    "package:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:win:x64": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run desktop:build && npm run package:mac",
    "dist:mac:x64": "npm run desktop:build && npm run package:mac:x64",
    "dist:mac:arm64": "npm run desktop:build && npm run package:mac:arm64",
    "dist:win": "npm run desktop:build && npm run package:win",
    "dist:win:x64": "npm run desktop:build && npm run package:win:x64",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "check:google-oauth": "node scripts/check-google-oauth.mjs",
    "check:supabase-sync": "node scripts/check-supabase-sync.mjs",
    "check:supabase-sync:auth": "node scripts/check-supabase-sync.mjs --require-auth",
    "check:supabase-sync:oauth": "node scripts/check-supabase-sync.mjs --oauth-login --require-auth",
    "check:supabase-migration": "node scripts/apply-supabase-migration.mjs",
    "apply:supabase-migration": "node scripts/apply-supabase-migration.mjs --apply",
    "check:desktop-package": "node scripts/check-desktop-package.mjs",
    "check:pages-deployment": "node scripts/check-pages-deployment.mjs",
    "print:supabase-migration": "node scripts/print-supabase-migration.mjs",
    "print:supabase-readiness-check": "node scripts/print-supabase-readiness-check.mjs",
    "verify:release:local": "npm run lint && npm test && npm run test:e2e && npm run desktop:pack && npm run check:desktop-package",
    "verify:release:online": "npm run check:google-oauth && npm run check:supabase-migration && npm run check:supabase-sync:oauth",
    "verify:release:online:manual": "npm run check:google-oauth && npm run check:supabase-sync:oauth",
    "verify:release:online:apply": "npm run check:google-oauth && npm run apply:supabase-migration && npm run check:supabase-sync:oauth",
    "test": "node scripts/prepare-tests.mjs && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "build": {
    "appId": "com.marknote.app",
    "productName": "MarkNote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "",
        "NSMicrophoneUsageDescription": "",
        "NSBluetoothAlwaysUsageDescription": ""
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "3.4.17",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "nanoid": "^5.1.5",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "turndown": "^7.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.34",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  }
}
